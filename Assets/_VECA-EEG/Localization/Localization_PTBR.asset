%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d, type: 3}
  m_Name: Localization_PTBR
  m_EditorClassIdentifier:
  buttonStart: INICIAR TESTE
  buttonGotIt: ENTENDIDO
  buttonRestart: NOVO TESTE
  gotItHint: "Para come\xE7ar, olhe para o bot\xE3o ENTENDIDO\nno canto da tela."
  introMessage: "Bem-vindo \xE0 Avalia\xE7\xE3o Cognitiva VECA-EEG.\n\nEste teste avalia fun\xE7\xF5es cognitivas como mem\xF3ria, aten\xE7\xE3o, abstra\xE7\xE3o, c\xE1lculo e execu\xE7\xE3o de comandos.\n\nEm cada etapa, leia a instru\xE7\xE3o com aten\xE7\xE3o e fixe o olhar na resposta correta entre as op\xE7\xF5es apresentadas na tela.\n\nQuando estiver pronto para come\xE7ar, olhe para <b>INICIAR TESTE</b>."
  statusCompleted: "Conclu\xEDdo"
  prepareMessage: "\n\nPrepare-se para come\xE7ar."
  completionMessage: "Avalia\xE7\xE3o conclu\xEDda!\n\nObrigado pela participa\xE7\xE3o.\nResultados salvos."
  feedbackTemplate: "{0}% do tempo na resposta correta"
  taskMemory: "MEM\xD3RIA"
  taskAttention: "ATEN\xC7\xC3O"
  taskAbstraction: "ABSTRA\xC7\xC3O"
  taskCalculation: "C\xC1LCULO"
  taskExecution: "EXECU\xC7\xC3O"
  taskRecall: "MEM\xD3RIA TARDIA"
  descMemory: "<b>TAREFA:</b> MEM\xD3RIA\n\nVoc\xEA ver\xE1 3 imagens, uma de cada vez, por alguns segundos.\nAp\xF3s um breve intervalo, a mesma imagem aparecer\xE1 misturada\ncom outras 3 op\xE7\xF5es — fixe o olhar nela.\n\n<b>Exemplo:</b> se voc\xEA viu um Le\xE3o, olhe para o Le\xE3o quando ele\naparecer entre as 4 op\xE7\xF5es.\n\nEsta tarefa tem 3 rodadas."
  descAttention: "<b>TAREFA:</b> ATEN\xC7\xC3O\n\nUma instru\xE7\xE3o ser\xE1 exibida na tela.\nLeia com aten\xE7\xE3o e fixe o olhar no item correto entre\nas 4 op\xE7\xF5es apresentadas.\n\n<b>Exemplo:</b> se a instru\xE7\xE3o diz \"Olhe para o brinquedo\",\nolhe para a imagem do brinquedo.\n\nEsta tarefa tem 1 rodada."
  descAbstraction: "<b>TAREFA:</b> ABSTRA\xC7\xC3O\n\nDois conceitos ser\xE3o exibidos na instru\xE7\xE3o.\nEntre as 4 op\xE7\xF5es, fixe o olhar na categoria que melhor\ndescreve o que eles t\xEAm em comum.\n\n<b>Exemplo:</b> \"Casa e Ponte\" → olhe para \"Constru\xE7\xF5es\".\n\nEsta tarefa tem 2 rodadas."
  descCalculation: "<b>TAREFA:</b> C\xC1LCULO\n\nUma opera\xE7\xE3o aritm\xE9tica ser\xE1 exibida na instru\xE7\xE3o.\nEntre as 4 op\xE7\xF5es na tela, fixe o olhar na resposta correta.\n\n<b>Exemplo:</b> \"10 − 8 =\" → olhe para o n\xFAmero 2.\n\nEsta tarefa tem 3 rodadas."
  descExecution: "<b>TAREFA:</b> EXECU\xC7\xC3O\n\nUm comando ser\xE1 exibido na instru\xE7\xE3o.\nLeia com aten\xE7\xE3o e fixe o olhar na op\xE7\xE3o correta entre\nas 4 apresentadas na tela.\n\n<b>Exemplo:</b> \"Olhe para o n\xFAmero que vem depois do 2:\n1 - 2 - ?\" → olhe para o n\xFAmero 3."
  descRecall: "<b>TAREFA:</b> MEM\xD3RIA TARDIA\n\nVoc\xEA se lembra das imagens que viu no in\xEDcio do teste?\n\nCada rodada apresentar\xE1 4 op\xE7\xF5es — fixe o olhar na imagem\nque foi mostrada l\xE1 no come\xE7o.\n\n<b>Exemplo:</b> se voc\xEA memorizou um Le\xE3o, fixe no Le\xE3o quando\nele aparecer entre as op\xE7\xF5es.\n\nEsta tarefa tem 3 rodadas e vai mostrar, em sequ\xEAncia,\na primeira, segunda e terceira imagens do in\xEDcio."
  memoryEncodePrompt: "Memorize esta imagem"
  memoryRecallPrompt: "\n\nFixe o olhar na resposta correta."
  memoryTargetLabels:
  - "Le\xE3o"
  - Rinoceronte
  - Camelo
  memoryDistractorLabels:
  - Elefante
  - Zebra
  - Girafa
  - Tigre
  - Lobo
  attentionInstrucao: "\n\n\nOlhe para o ANIMAL SELVAGEM."
  attentionOpcoes:
  - "Le\xE3o"
  - Vaca
  - Porco
  - Galinha
  attentionRespostaCorreta: "Le\xE3o"
  abstractionComplement: "O que t\xEAm em comum?"
  abstractionTrials:
  - par: Trem e Bicicleta
    opcoes:
    - Transporte
    - Animal
    - Cor
    - Alimento
    respostaCorreta: Transporte
  - par: "Rel\xF3gio e R\xE9gua"
    opcoes:
    - "Medi\xE7\xE3o"
    - Ferramenta
    - Brinquedo
    - Roupa
    respostaCorreta: "Medi\xE7\xE3o"
  calculationPrompt: "Olhe para a resposta correta."
  executionInstrucao: "\n\nOlhe para o n\xFAmero que vem depois do 7 na sequ\xEAncia: 8 - 7 - ?"
  executionOpcoes:
  - "6"
  - "4"
  - "7"
  - "5"
  executionRespostaCorreta: "6"
  recallOrdinals:
  - primeira
  - segunda
  - terceira
  recallPromptTemplate: "\nVoc\xEA se lembra da <b>{0}</b> imagem mostrada no in\xEDcio?\nAgora tente lembrar e olhe para ela."
